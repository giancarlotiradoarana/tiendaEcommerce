# Copia este archivo como ".env" y completa los valores.

# Base de datos
DATABASE_URL="file:./dev.db"

# Autenticación (genera un secret aleatorio largo para producción)
NEXTAUTH_SECRET="cambia-esto-por-un-valor-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"

# Notificaciones de pedido
NOTIFY_PHONE="51900000000"        # Código de país + número
WHATSAPP_TOKEN=""                 # Opcional: WhatsApp Cloud API
WHATSAPP_PHONE_ID=""              # Opcional

# Notificaciones push web (genera las claves con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@tudominio.com"
